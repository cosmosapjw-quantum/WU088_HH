      "properties": {
        "parameters": {"type": "object"}, "source": {"type": "object"}, "requested_times": {"$ref": "#/$defs/rational_list"}, "base_times": {"$ref": "#/$defs/rational_list"}, "refined_times": {"$ref": "#/$defs/rational_list"},
        "exact": {"type": "object", "additionalProperties": false, "required": ["F_at_refined", "R_at_refined", "kernel_at_refined", "R_quartic_cells", "observation_R_suprema"], "properties": {"F_at_refined": {"$ref": "#/$defs/rational_list"}, "R_at_refined": {"$ref": "#/$defs/rational_list"}, "kernel_at_refined": {"$ref": "#/$defs/rational_list"}, "R_quartic_cells": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/cell"}}, "observation_R_suprema": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/supremum"}}}},
        "raw": {"$ref": "#/$defs/raw"}, "weights": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/weight"}}, "work": {"type": "object"}, "certificate_status": {"type": "string"}, "input_scientific_status": {"enum": ["ARITHMETIC_CONTROL_PREMISE", "CERTIFIED_FULL_A_BLOCK"]}, "source_provenance": {"type": "object"}, "R_history": {"type": "string"}, "cap_application": {"type": "string"}, "arithmetic": {"type": "object"}
      }
