      "properties": {"exact_lower": {"$ref": "#/$defs/rational"}, "exact_upper": {"$ref": "#/$defs/rational"}, "exact_gap": {"$ref": "#/$defs/rational"}, "M_B": {"$ref": "#/$defs/rational"}, "Cmax": {"$ref": "#/$defs/rational"}, "proved_gap_bound": {"$ref": "#/$defs/rational"}, "dyadic_lower": {"$ref": "#/$defs/rational"}, "dyadic_upper": {"$ref": "#/$defs/rational"}}
