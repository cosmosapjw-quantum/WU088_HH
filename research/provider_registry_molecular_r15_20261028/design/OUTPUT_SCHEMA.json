      "properties": {
        "left": {"$ref": "#/$defs/rational"}, "right": {"$ref": "#/$defs/rational"}, "bernstein": {"$ref": "#/$defs/five"}, "coefficients_normalized": {"$ref": "#/$defs/five"}, "initial_piece": {"$ref": "#/$defs/rational"}, "F_bernstein": {"$ref": "#/$defs/five"}, "right_left_limit": {"$ref": "#/$defs/rational"}, "actual_right_endpoint": {"$ref": "#/$defs/rational"}, "ge_bernstein": {"$ref": "#/$defs/four"}, "forcing_bernstein": {"$ref": "#/$defs/five"}, "subdivision": {"$ref": "#/$defs/subdivision"}, "supremum": {"$ref": "#/$defs/supremum"}, "whole_E_majorant": {"type": "object", "required": ["Qmax", "left_E_upper", "right_majorant_upper"], "properties": {"Qmax": {"$ref": "#/$defs/rational"}, "left_E_upper": {"$ref": "#/$defs/rational"}, "right_majorant_upper": {"$ref": "#/$defs/rational"}}}
