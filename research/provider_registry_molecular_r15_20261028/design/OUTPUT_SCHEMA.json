      "properties": {"endpoints_lower": {"$ref": "#/$defs/matrix2"}, "endpoints_upper": {"$ref": "#/$defs/matrix2"}, "whole_cells_lower": {"$ref": "#/$defs/matrix2"}, "whole_cells_upper": {"$ref": "#/$defs/matrix2"}, "refined_endpoints_lower": {"$ref": "#/$defs/matrix2"}, "refined_endpoints_upper": {"$ref": "#/$defs/matrix2"}, "refined_whole_cells_lower": {"$ref": "#/$defs/matrix2"}, "refined_whole_cells_upper": {"$ref": "#/$defs/matrix2"}}
