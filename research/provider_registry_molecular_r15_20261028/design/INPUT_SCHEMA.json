{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WU_R15_INPUT_SCHEMA_V1",
  "title": "WU R15 exact supplied Bernstein-B3 comparison input",
  "description": "C2 authored schema. Cross-field equality, rational bit limits, strict monotonicity, full-block count and source hash are semantic validation obligations in API_SCHEMA.md. Metadata declares premises; it does not verify physical provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["states", "q", "tau", "c", "d", "initial", "source_knots", "observation_knots", "g_r", "g_e", "binding", "certificate"],
  "properties": {
    "states": {"type": "integer", "minimum": 1, "maximum": 13},
    "q": {"$ref": "#/$defs/scalar"},
    "tau": {"$ref": "#/$defs/scalar"},
    "c": {"$ref": "#/$defs/scalar"},
    "d": {"$ref": "#/$defs/scalar"},
    "initial": {"$ref": "#/$defs/pair"},
    "source_knots": {"type": "array", "minItems": 2, "maxItems": 17, "items": {"$ref": "#/$defs/scalar"}},
    "observation_knots": {"type": "array", "minItems": 2, "maxItems": 33, "items": {"$ref": "#/$defs/scalar"}},
    "g_r": {"$ref": "#/$defs/source_rows"},
    "g_e": {"$ref": "#/$defs/source_rows"},
    "binding": {"$ref": "#/$defs/identity"},
    "certificate": {"$ref": "#/$defs/certificate"}
  },
  "$defs": {
    "scalar": {"oneOf": [{"type": "integer"}, {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[+-]?[0-9]+(/[+-]?[0-9]+)?$"}], "description": "ASCII grammar only. Booleans/floats are rejected by the Python semantic parser even if a generic JSON Schema numeric implementation conflates them. Denominator is nonzero; numerator and denominator bit lengths are at most256."},
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/scalar"}},
    "source_rows": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/scalar"}}, "description": "Each row is exactly four nonnegative B3 coefficients on an original source cell. Length equals source_knots length minus1."},
    "text": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_order": {"type": "array", "minItems": 1, "maxItems": 13, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "clock_id", "clock_unit", "full_A_family_id", "source_locator", "source_sha256", "whole_forcing_source_sha256", "scientific_status", "state_order", "whole_forcing_hash_format"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"}, "clock_id": {"$ref": "#/$defs/text"}, "clock_unit": {"$ref": "#/$defs/text"}, "full_A_family_id": {"$ref": "#/$defs/text"}, "source_locator": {"$ref": "#/$defs/text"},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "whole_forcing_source_sha256": {"$ref": "#/$defs/sha256"},
        "scientific_status": {"enum": ["ARITHMETIC_CONTROL_PREMISE", "CERTIFIED_FULL_A_BLOCK"]},
        "state_order": {"$ref": "#/$defs/state_order"}, "whole_forcing_hash_format": {"const": "WU_R15_WHOLE_FORCING_V1"}
      }
    },
    "certificate": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "clock_id", "clock_unit", "full_A_family_id", "source_locator", "source_sha256", "whole_forcing_source_sha256", "scientific_status", "state_order", "whole_forcing_hash_format", "generator", "fixed_K_pi_d", "full_w_box", "all_start_times", "zero_mass_residual", "short_remainder_nonexpansive", "forcing_whole_fine_coarse_domain", "q", "tau", "t0", "T", "w_box"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"}, "clock_id": {"$ref": "#/$defs/text"}, "clock_unit": {"$ref": "#/$defs/text"}, "full_A_family_id": {"$ref": "#/$defs/text"}, "source_locator": {"$ref": "#/$defs/text"},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "whole_forcing_source_sha256": {"$ref": "#/$defs/sha256"},
        "scientific_status": {"enum": ["ARITHMETIC_CONTROL_PREMISE", "CERTIFIED_FULL_A_BLOCK"]}, "state_order": {"$ref": "#/$defs/state_order"}, "whole_forcing_hash_format": {"const": "WU_R15_WHOLE_FORCING_V1"},
        "generator": {"const": "A=K+wH;H=pi*d^T-diag(d)"},
        "fixed_K_pi_d": {"const": true}, "full_w_box": {"const": true}, "all_start_times": {"const": true}, "zero_mass_residual": {"const": true}, "short_remainder_nonexpansive": {"const": true}, "forcing_whole_fine_coarse_domain": {"const": true},
        "q": {"$ref": "#/$defs/scalar"}, "tau": {"$ref": "#/$defs/scalar"}, "t0": {"$ref": "#/$defs/scalar"}, "T": {"$ref": "#/$defs/scalar"}, "w_box": {"$ref": "#/$defs/pair"}
      }
    }
  },
  "x-semantic-validation": ["0<=q<=1; tau>0; c>=0; initial>=0", "All original B3 coefficients>=0; singleton R0 and g_r exactly0", "Exact source and observation clocks strictly increase and share t0/T", "floor((T-t0)/tau)<=8; abs(d)*(T-t0)<=16", "Identity and certificate fields match; q/tau/t0/T match; w_box nonnegative and ordered", "state_order length equals states", "Canonical whole-forcing SHA256 recomputes from normalized exact source, state and clock", "Nbase<=512 and all overlap/subdivision work precharged before traversal", "No generic cap adapter or nominal-K rate substitution"]
}
