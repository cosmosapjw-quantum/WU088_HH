  "findings": [
    {
      "counterexample": "Two versions of m3_postidle.py or controls.py can produce the same numeric_context and run schema because neither script hash nor reviewed commit/tree is included in the recorded state. The run files therefore cannot by themselves identify the exact adapter that generated the measurements.",
      "id": "BR-01",
      "impact": "A later independent reviewer cannot establish from the raw run that the measured control path is the reviewed commit, even though legacy arithmetic and binary inputs are pinned.",
      "location": "research/r31v_postidle/m3_postidle.py:296-310; evidence/ncp_host/20260928T132239Z_r31v/m3b_132.json and reference_prepare.json",
      "observed_actual_misconduct": false,
      "required_change": "Record SHA-256 of m3_postidle.py and controls.py and the Git commit/tree in both preparation and benchmark evidence at execution time; independently verify the recorded values before relying on the run.",
      "severity": "medium"
    },
    {
      "counterexample": "After prepare, a local writer can change a reference cache entry and recompute its unkeyed payload_sha256 while retaining the same context, pair and path. ReferenceCache.read accepts the new finite arrays. Neither the prepare nor benchmark record freezes the per-entry file or payload SHA-256, so the two phases cannot be byte-linked retrospectively.",
      "id": "BR-02",
      "impact": "The copied cache is internally consistent, but it is not evidence that benchmark read the exact reference bytes produced during explicit preparation. This is an evidence provenance gap, not evidence that modification occurred.",
      "location": "research/r31v_postidle/controls.py:210-254; research/r31v_postidle/m3_postidle.py:346-361; reference_prepare.json and m3b_132.json",
      "observed_actual_misconduct": false,
      "required_change": "Record the ordered pair-to-cache-file SHA-256 map at completion of prepare and at benchmark read, and require equality; preserve those hashes with the raw record.",
      "severity": "medium"
    },
    {
      "counterexample": "Calling benchmark with all required path arguments and --configs 64x1,bad raises ValueError before atomic_json creates the output checkpoint. A bounded stub-controls execution reproduced exit with no output file and no native import.",
      "id": "BR-03",
      "impact": "Malformed configuration and other errors before state creation leave no failure record under --out, despite the run contract calling for failure preservation.",
      "location": "research/r31v_postidle/m3_postidle.py:272-298",
      "observed_actual_misconduct": false,
      "required_change": "Create a minimal attempted-run checkpoint before fallible layout/grant/pilot preflight, then update it with a precise validation failure without importing native code.",
      "severity": "low"
    }
  ],
