ClearAll["Global`*"];
Needs["xAct`xTensor`"];
DefManifold[HH22,4,{a,b,c,d}];
DefMetric[-1,met[-a,-b],CD];
DefTensor[uu[a],HH22];
DefTensor[nh[],HH22];
DefTensor[e0[],HH22]; DefTensor[e1[],HH22];
DefTensor[w0[],HH22]; DefTensor[w1[],HH22];
DefConstantSymbol[cs]; DefConstantSymbol[ct]; DefConstantSymbol[chi]; DefConstantSymbol[ff];
canon[expr_]:=ToCanonical[Expand[expr]];
current=canon[CD[-a][nh[] e1[] uu[a]]-CD[-a][nh[] e0[] uu[a]]-(e1[]-e0[])CD[-a][nh[] uu[a]]-nh[] uu[a]CD[-a][e1[]-e0[]]];
energy=canon[CD[-a][nh[] w1[] uu[a]]-CD[-a][nh[] w0[] uu[a]]-(w1[]-w0[])CD[-a][nh[] uu[a]]-nh[] uu[a]CD[-a][w1[]-w0[]]];
binding=canon[uu[a]CD[-a][w1[]-w0[]+chi(e1[]-e0[])]-uu[a]CD[-a][w1[]-w0[]]-chi uu[a]CD[-a][e1[]-e0[]]];
temp0=ct w0[]/(1+ff+e0[]); temp1=ct w1[]/(1+ff+e1[]);
quotient=ToCanonical[Together[temp1-temp0-(ct(w1[]-w0[])-temp0(e1[]-e0[]))/(1+ff+e1[])]];
DefTensor[tt[],HH22];
clock=canon[cs uu[a]CD[-a][tt[]/cs]-uu[a]CD[-a][tt[]]];
scalar={Expand[(ss-(kap+dk)(mm+dm))-(ss-kap mm)+(kap+dk)dm+dk mm],Expand[(bb+db)(mm+dm)-bb mm-db mm-(bb+db)dm],Together[ctt(ww+dww)/(pp+dee)-ctt ww/pp-(ctt dww-(ctt ww/pp)dee)/(pp+dee)],Together[Integrate[Integrate[1,{r,0,s}],{s,0,h}]-h^2/2],Together[Integrate[Exp[-k(h-s)],{s,0,h},Assumptions->k>0&&h>0]-(1-Exp[-k h])/k],Limit[(1-Exp[-k h])/k,k->0]-h};
checks=<|"electron_current_difference"->current,"energy_current_difference"->energy,"chemical_energy_linearity"->binding,"finite_temperature_quotient"->quotient,"proper_length_clock"->clock|>;
all=Join[Values[checks],scalar];
result=<|"status"->If[And@@(TrueQ[#===0]&/@all),"PASS","FAIL"],"kernel"->System`$Version,"xTensor_path"->FindFile["xAct`xTensor`"],"xTensor_init_sha256"->FileHash[FindFile["xAct`xTensor`"],"SHA256","HexString"],"xPerm_path"->FindFile["xAct`xPerm`"],"tensor_checks"->checks,"scalar_checks"->scalar,"residual_count"->Length[all],"all_literal_zero"->And@@(TrueQ[#===0]&/@all)|>;
Export[FileNameJoin[{DirectoryName[$InputFileName],"xact_result_v2.json"}],result,"RawJSON"];
Print[ExportString[result,"RawJSON"]];
If[!TrueQ[result["all_literal_zero"]],Exit[2]];
