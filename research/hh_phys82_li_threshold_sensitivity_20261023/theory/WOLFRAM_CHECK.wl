Clear[p,x,th,i0,dd,ss,cc,ee,lam,kt,kg]; f[a_,z_]:=Gamma[a+1,0,z]/z^(a+1); g0= i0 f[p,dd/th]+dd f[p+1,dd/th]; h0=i0^2 f[p,dd/th]+2 i0 dd f[p+1,dd/th]+dd^2 f[p+2,dd/th]; g1=(i0+dd) f[p,dd/th]; h1=(i0+dd)(i0 f[p,dd/th]+dd f[p+1,dd/th]); asm=p>0&&th>0&&i0>0&&dd>0; dg0=TimeConstrained[FullSimplify[th^2 D[Exp[-i0/th]g0,th]-Exp[-i0/th]h0,Assumptions->asm],12,"TIMEOUT"]; dg1=TimeConstrained[FullSimplify[th^2 D[Exp[-i0/th]g1,th]-Exp[-i0/th]h1,Assumptions->asm],12,"TIMEOUT"]; lin=FullSimplify[f[1,x]-(1-Exp[-x](1+x))/x^2,Assumptions->x>0]; expo=FullSimplify[Exp[-lam kt]-Exp[-lam(kt+kg)]-Exp[-lam kt](1-Exp[-lam kg])]; ExportString[<|"q0_moment_derivative_residual"->ToString[dg0,InputForm],"q1_moment_derivative_residual"->ToString[dg1,InputForm],"p1_moment_residual"->ToString[lin,InputForm],"exposure_identity_residual"->ToString[expo,InputForm],"pW_exact"->ToString[(Sqrt[91/3]-1)/4,InputForm],"pW_decimal"->ToString[N[(Sqrt[91/3]-1)/4,30],InputForm]|>,"RawJSON"]
