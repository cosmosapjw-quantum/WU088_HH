Module[{dir,arc,xf,tensorResult,scalarChecks},dir=CreateDirectory[];arc=FileNameJoin[{dir,"xAct_1.3.0.tgz"}];URLDownload["https://xact.es/download/xAct_1.3.0.tgz",arc];ExtractArchive[arc,dir];xf=First[Select[FileNames["xTensor.m",dir,Infinity],StringEndsQ[#,"/xAct/xTensor/xTensor.m"]&]];PrependTo[$Path,DirectoryName[xf,3]];PrependTo[$Path,DirectoryName[xf,2]];Get[xf];tensorResult=ToExpression["\n$xpermQ = False;\nDefManifold[HHState16,4,{aa16,bb16,cc16,dd16,ee16,ff16}];\nDefTensor[Disp16[aa16],HHState16];\nDefTensor[SectorDisp16[aa16],HHState16];\nDefTensor[Jac16[aa16,-bb16],HHState16];\nDefTensor[K16[aa16,-bb16],HHState16];\nDefTensor[Adj16[-aa16],HHState16];\nDefTensor[Goal16[-aa16],HHState16];\nDefTensor[Rem16[aa16],HHState16];\nDefTensor[Hess16[aa16,-bb16,-cc16],HHState16,Symmetric[{-bb16,-cc16}]];\nDefTensor[PhotVec16[aa16],HHState16];\nDefTensor[OpacityCov16[-aa16],HHState16];\ntensorChecks16 = <|\n\"HessianLastPairSymmetry\" -> ToCanonical[Hess16[aa16,-bb16,-cc16]-Hess16[aa16,-cc16,-bb16]],\n\"TaylorResidualTransfer\" -> ToCanonical[Expand[(Jac16[aa16,-bb16]-K16[aa16,-bb16])Disp16[bb16]-(Jac16[aa16,-cc16]Disp16[cc16]-K16[aa16,-dd16]Disp16[dd16])]],\n\"DualResidualGoal\" -> ToCanonical[Expand[Goal16[-aa16]Disp16[aa16]-Adj16[-aa16](Jac16[aa16,-bb16]Disp16[bb16]-Rem16[aa16])-(Goal16[-aa16]-Jac16[bb16,-aa16]Adj16[-bb16])Disp16[aa16]-Adj16[-aa16]Rem16[aa16]]],\n\"CommonSectorAdjoint\" -> ToCanonical[Expand[Goal16[-aa16]SectorDisp16[aa16]-Adj16[-aa16](Jac16[aa16,-bb16]-K16[aa16,-bb16])SectorDisp16[bb16]-(Goal16[-aa16]-Adj16[-bb16]Jac16[bb16,-aa16]+Adj16[-cc16]K16[cc16,-aa16])SectorDisp16[aa16]]],\n\"HessianGoalContraction\" -> ToCanonical[Adj16[-aa16]Hess16[aa16,-bb16,-cc16]Disp16[bb16]Disp16[cc16]-Adj16[-bb16]Hess16[bb16,-aa16,-cc16]Disp16[aa16]Disp16[cc16]],\n\"PhotonRankOneAction\" -> ToCanonical[PhotVec16[aa16]OpacityCov16[-bb16]Disp16[bb16]-PhotVec16[aa16]OpacityCov16[-cc16]Disp16[cc16]]\n|>;\n<|\"Backend\"->\"xAct xTensor with xPerm Wolfram Language group algorithms\",\"ExternalCanonicalizerUsed\"->$xpermQ,\"TensorChecks\"->tensorChecks16,\"TensorAllZero\"->And@@(#===0& /@ Values[tensorChecks16]),\"Messages\"->$MessageList|>\n"];
