  "assumptions": [
    "Finite nonnegative machine binary64 operand values are separately authenticated or enclosed by independently established forward-error bounds.",
    "Exactly two metric scalars; unchanged source token 0x3ddb7cdfd9d7bdbb.",
    "Scalar addition/subtraction R is correctly rounded nearest ties-even, gradual underflow, no alternative intermediate precision/double rounding/reassociation.",
    "Protected finite exact b+tau<=F for every operand pair being certified; reversed comparison rechecks its own domain.",
    "The threshold neighbor used by a preimage row is finite; secondary strict at a=F is explicitly false.",
    "Source-ideal target-gap arguments require fixed correctly bound models and common target perturbation bounds."
  ],
  "rounding_preimages": {
    "definition": "m_minus(q)=(pred(q)+q)/2; m_plus(q)=(q+succ(q))/2; E(q)=low significand bit is zero; signed zeros collapsed for comparisons",
    "RN_x_ge_q": "x>m_minus(q) OR (x==m_minus(q) AND E(q))",
    "RN_x_gt_q": "x>m_plus(q) OR (x==m_plus(q) AND NOT E(q))",
    "RN_x_le_q": "x<m_plus(q) OR (x==m_plus(q) AND E(q))",
    "RN_x_lt_q": "x<m_minus(q) OR (x==m_minus(q) AND NOT E(q))"
  },
  "point_gap_predicates": {
    "gap": "g=b-a exact dyadic",
    "weak": "g>-tau-h_minus(a) OR (equality AND E(a))",
    "PRIMARY_strict": "g>=tau+2^-87 for this frozen odd tolerance",
    "SECONDARY_strict": "g>tau+h_plus(a) OR (equality AND NOT E(a)); false at a=F",
    "h_minus": "(a-pred(a))/2",
    "h_plus": "(succ(a)-a)/2",
    "pareto": "both weak AND at least one comparison-specific strict"
  },
  "interval_implication": {
    "premise": "Machine operands lie in exact rational enclosures, intersected with nonnegative finite binary64 lattice; empty intersections refuse.",
    "worst_corner": "a=max feasible local scalar; b=min feasible other scalar; apply exact point predicates.",
    "proof": "All three source predicates are antitone in a and monotone in b.",
    "claim": "Sufficient for every feasible machine pair; exact universal criterion on Cartesian boxes; unresolved does not mean actual false.",
    "forward_error_bridge": "If |a-e_a|<=rho_a and e_a in [L,U], then a in [max(0,L-rho_a),U+rho_a].",
    "norm_correct_rounding_not_assumed": true
  },
  "gap_only_implication": {
    "machine_gap_lower": "B=G-rho_a-rho_b under independently proved scalar error bounds",
