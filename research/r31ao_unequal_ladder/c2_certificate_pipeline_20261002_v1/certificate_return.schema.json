{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WU088 C2 external assembly return (reported evidence only)",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "returncode",
    "native_wait_completed",
    "native_executed",
    "precision_bits",
    "scientific_admission",
    "production_admission",
    "preparation_sha256",
    "assembly_input_sha256",
    "native_stdout_sha256",
    "native_stderr_sha256",
    "binary_sha256",
    "backend_provenance_sha256",
    "build_manifest_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "WU088_C2_ASSEMBLY_RETURN_V1"
    },
    "kind": {
      "enum": [
        "SYNTHETIC_TEST_ONLY",
        "SOURCE_BOUND_REPORTED"
      ]
    },
    "returncode": {
      "const": 0
    },
    "native_wait_completed": {
      "const": true
    },
    "native_executed": {
      "type": "boolean"
    },
    "precision_bits": {
      "const": 128
    },
    "scientific_admission": {
      "const": false
    },
    "production_admission": {
      "const": false
    },
    "preparation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assembly_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_stdout_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_stderr_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backend_provenance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SYNTHETIC_TEST_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "native_executed": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "native_executed": {
            "const": true
          }
        }
      }
    }
  ]
}
